---
import { periode, type Prosjekt } from "@/lib/prosjekter";

interface Props {
  prosjekter: Prosjekt[];
}
const { prosjekter } = Astro.props;
---

<ul class="liste">
  {
    prosjekter.map((p) => {
      const lenke = p.data.lenker[0];
      return (
        <li>
          <p class="aar">{periode(p.data)}</p>
          <div>
            <h3>{p.data.tittel}</h3>
            {p.data.rolle && <p class="rolle">{p.data.rolle}</p>}
          </div>
          <div>
            <p>{p.data.ingress}</p>
            {lenke && (
              <a class="lenke" href={lenke.url}>
                {lenke.tekst}
              </a>
            )}
          </div>
        </li>
      );
    })
  }
</ul>

<style>
  .liste {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--color-grafitt);
  }
  li {
    display: grid;
    gap: 0.4rem 2rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-linje);
  }
  @media (min-width: 48rem) {
    li {
      grid-template-columns: 8rem 1fr 1.6fr;
    }
  }
  .aar,
  .rolle {
    font-size: var(--text-liten);
    color: var(--color-blyant);
  }
  .aar {
    padding-top: 0.25rem;
  }
  h3 {
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  li p {
    max-width: 38rem;
  }
  .lenke {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: var(--text-liten);
  }
</style>
