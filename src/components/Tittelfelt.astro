---
// Faktaboks utformet som tittelfeltet på en arbeidstegning.
interface Felt {
  etikett: string;
  verdi?: string | string[];
}
interface Props {
  felt: Felt[];
}
const synlige = Astro.props.felt.filter((f) =>
  Array.isArray(f.verdi) ? f.verdi.length > 0 : Boolean(f.verdi),
);
---

<dl class="tittelfelt">
  {
    synlige.map((f) => (
      <div class="celle">
        <dt>{f.etikett}</dt>
        <dd>{Array.isArray(f.verdi) ? f.verdi.join(", ") : f.verdi}</dd>
      </div>
    ))
  }
</dl>

<style>
  .tittelfelt {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    border: 1px solid var(--color-grafitt);
    background: var(--color-ark);
    /* Indre streker: hver celle tegner høyre og nedre kant; rammen skjuler overskuddet */
    overflow: hidden;
  }
  .celle {
    padding: 0.85rem 1rem 1rem;
    border-right: 1px solid var(--color-linje);
    border-bottom: 1px solid var(--color-linje);
    margin-right: -1px;
    margin-bottom: -1px;
  }
  dt {
    font-size: var(--text-liten);
    color: var(--color-blyant);
    line-height: 1.3;
  }
  dd {
    margin-top: 0.3rem;
    font-weight: 560;
    line-height: 1.35;
  }
</style>
