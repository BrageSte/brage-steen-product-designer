---
// En innsikt eller et sitat som bærer prosjektet. Brukes sparsomt — maks én–to per side.
interface Props {
  kilde?: string;
}
const { kilde } = Astro.props;
---

<figure class="blokk innsikt">
  <blockquote><slot /></blockquote>
  {kilde && <figcaption>{kilde}</figcaption>}
</figure>

<style>
  .innsikt {
    max-width: 46rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-kulepenn);
  }
  blockquote {
    font-size: var(--text-h3);
    line-height: 1.25;
    font-weight: 560;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  blockquote :global(p) {
    max-width: none;
  }
  figcaption {
    margin-top: 0.8rem;
    font-size: var(--text-liten);
    color: var(--color-blyant);
  }
</style>
