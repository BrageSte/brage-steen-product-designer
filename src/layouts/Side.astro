---
import "@/styles/global.css";
import Topptekst from "@/components/Topptekst.astro";
import Bunntekst from "@/components/Bunntekst.astro";

interface Props {
  tittel?: string;
  beskrivelse?: string;
  delingsbilde?: string; // sti under public/ eller absolutt URL
  ikkeIndekser?: boolean;
}
const {
  tittel,
  beskrivelse = "Produktdesigner som designer produkter og bygger dem for å finne ut om de virker. Industridesign, tjenestedesign og prototyping.",
  delingsbilde = "/images/og-image.jpg",
  ikkeIndekser = false,
} = Astro.props;
const fullTittel = tittel ? `${tittel} — Brage Steen` : "Brage Steen — Produktdesigner";
const kanonisk = new URL(Astro.url.pathname, Astro.site);
const bildeUrl = new URL(delingsbilde, Astro.site);
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTittel}</title>
    <meta name="description" content={beskrivelse} />
    <link rel="canonical" href={kanonisk} />
    {ikkeIndekser && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#eef0ed" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:title" content={fullTittel} />
    <meta property="og:description" content={beskrivelse} />
    <meta property="og:url" content={kanonisk} />
    <meta property="og:image" content={bildeUrl} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="hopp" href="#innhold">Hopp til innhold</a>
    <Topptekst />
    <main id="innhold">
      <slot />
    </main>
    <Bunntekst />
  </body>
</html>

<style>
  .hopp {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    background: var(--color-grafitt);
    color: var(--color-ark);
  }
  .hopp:focus {
    top: 1rem;
  }
</style>
