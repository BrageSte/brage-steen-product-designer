// Cloudflare Workers (statiske filer). Bygg: npm run build → dist/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brage-steen-product-designer",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/projects/sorting-guide/prototype-gjennomgang.mp4"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Kreves for forhåndsvisning per gren (Workers Previews)
  "previews": {}
}
